<div class="awake-exhaustion-talent-fields">

  <div class="awake-item-header">

    <img
      class="awake-item-image"
      src="{{item.img}}"
      alt="{{item.name}}"
      data-edit="img"
      data-action="editImage"
    />

    <div class="awake-item-header-fields">

      <label class="awake-field">
        <span>{{localize "AWAKE.Items.Name"}}</span>

        <input
          type="text"
          name="name"
          value="{{item.name}}"
          {{#unless editable}}disabled{{/unless}}
        />
      </label>

      <label class="awake-field">
        <span>{{localize "AWAKE.Items.Scope"}}</span>

        <input
          type="text"
          name="system.scope"
          value="{{system.scope}}"
          {{#unless editable}}disabled{{/unless}}
        />
      </label>

    </div>

  </div>

  <label class="awake-item-description">
    <span>{{localize "AWAKE.Items.Description"}}</span>

    <textarea
      name="system.description"
      rows="6"
      {{#unless editable}}disabled{{/unless}}
    >{{system.description}}</textarea>
  </label>

  <section class="awake-talent-rules">
    <h3>{{localize "AWAKE.ExhaustionTalent.Rules"}}</h3>

    <p>
      <strong>{{localize "AWAKE.ExhaustionTalent.MinorUse"}}</strong><br>
      {{localize "AWAKE.ExhaustionTalent.MinorUseText"}}
    </p>

    <p>
      <strong>{{localize "AWAKE.ExhaustionTalent.MajorUse"}}</strong><br>
      {{localize "AWAKE.ExhaustionTalent.MajorUseText"}}
    </p>
  </section>

</div>