<div class="awake-exhaustion-talent-fields">

  <div class="awake-talent-header">

    <img
      class="awake-talent-image"
      src="{{item.img}}"
      alt="{{item.name}}"
      data-edit="img"
      data-action="editImage"
    />

    <div class="awake-talent-header-fields">

      <label class="awake-field">
        <span>{{localize "AWAKE.Items.Name"}}</span>

        <input
          type="text"
          name="name"
          value="{{item.name}}"
          {{#unless editable}}disabled{{/unless}}
        />
      </label>

      <label class="awake-field awake-talent-description">
        <span>{{localize "AWAKE.Items.Description"}}</span>

        <textarea
          name="system.description"
          rows="4"
          {{#unless editable}}disabled{{/unless}}
        >{{system.description}}</textarea>
      </label>

    </div>

  </div>

  <section class="awake-section">

    <header class="awake-section-header">
      <h3>{{localize "AWAKE.ExhaustionTalent.MinorUse"}}</h3>
    </header>

    <p class="awake-rule-text">
      {{localize "AWAKE.ExhaustionTalent.MinorUseText"}}
    </p>

  </section>

  <section class="awake-section">

    <header class="awake-section-header">
      <h3>{{localize "AWAKE.ExhaustionTalent.MajorUse"}}</h3>
    </header>

    <p class="awake-rule-text">
      {{localize "AWAKE.ExhaustionTalent.MajorUseText"}}
    </p>

  </section>

</div>