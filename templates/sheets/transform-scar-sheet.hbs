<div class="awake-transform-scar">

  {{#if available}}

    <h3>{{actorName}}</h3>

    {{#if preventCrash}}
    <p class="awake-transform-crash-warning">
        {{localize "AWAKE.Scars.PreventCrashWarning"}}
    </p>
    {{/if}}

    {{#if inConflict}}

  <div class="form-group">
    <label>
      {{localize "AWAKE.Scars.TransformSelectScar"}}
    </label>

    <select name="scarIndex" required>
      {{#each scars}}
        <option value="{{index}}">
          {{text}}
        </option>
      {{/each}}
    </select>
  </div>

{{else}}

  <p class="awake-transform-scar-text">
    {{scarText}}
  </p>

{{/if}}

    <div class="form-group">
        <label>
            {{localize "AWAKE.Scars.TransformEffect"}}
        </label>

        <select name="effect">

            <option value="hope">
                {{localize "AWAKE.Scars.TransformHope"}}
            </option>

            {{#unless preventCrash}}

                <option value="madnessTalent">
                {{localize "AWAKE.Scars.TransformMadnessTalent"}}
                </option>

                <option value="exhaustionTalent">
                {{localize "AWAKE.Scars.TransformExhaustionTalent"}}
                </option>

            {{/unless}}

        </select>
    </div>

    <p data-transform-talent-note hidden>
        {{localize "AWAKE.Scars.TransformTalentReminder"}}
    </p>

    <fieldset class="awake-transform-hope-fields"
          data-transform-hope-fields>
        <h3>
        {{localize "AWAKE.Scars.TransformHope"}}
        </h3>

        <p>
        {{localize "AWAKE.Scars.TransformHopeReminder"}}
        </p>

        <div class="awake-transform-hope-budget">
            <span>
                {{localize "AWAKE.Scars.AvailableHope"}}
            </span>

            <strong data-transform-hope-budget>
                5 / 5
            </strong>
        </div>
        {{#if inConflict}}
            {{#unless preventCrash}}
            <div class="form-group">
                <label>
                {{localize "AWAKE.Scars.ImproveSuccess"}}
                </label>

                <input
                type="number"
                name="improveSuccess"
                value="0"
                min="0"
                max="5"
                step="1"
                required
                />
            </div>
            {{/unless}}
        {{/if}}

        <div class="form-group">
        <label>
            {{localize "AWAKE.Hope.ReduceExhaustion"}}
        </label>

        <input
            type="number"
            name="exhaustion"
            value="{{#if preventCrash}}1{{else}}0{{/if}}"
            min="{{#if preventCrash}}1{{else}}0{{/if}}"
            max="{{maxExhaustion}}"
            step="1"
            required
        />
        </div>

        <div class="form-group">
        <label>
            {{localize "AWAKE.Hope.ClearFight"}}
        </label>

        <input
            type="number"
            name="fight"
            value="0"
            min="0"
            max="{{maxFight}}"
            step="1"
            required
        />
        </div>

        <div class="form-group">
        <label>
            {{localize "AWAKE.Hope.ClearFlight"}}
        </label>

        <input
            type="number"
            name="flight"
            value="0"
            min="0"
            max="{{maxFlight}}"
            step="1"
            required
        />
        </div>

        {{#if canRestoreDiscipline}}
        <div class="form-group">
            <label>
            {{localize "AWAKE.Hope.RestoreDiscipline"}}
            ({{restoreCost}} Hope)
            </label>

            <select name="restoreDiscipline">
            <option value="0">0</option>
            <option value="1">1</option>
            </select>
        </div>
        {{/if}}

    </fieldset>

    <p class="awake-transform-warning">
      {{localize "AWAKE.Scars.TransformWarning"}}
    </p>

    <div class="awake-transform-actions">

      <button
        type="button"
        data-action="cancel"
      >
        {{localize "AWAKE.Scars.Cancel"}}
      </button>

      <button type="submit">
        {{localize "AWAKE.Scars.Transform"}}
      </button>

    </div>

  {{else}}

    <p>
      {{localize "AWAKE.Scars.TransformUnavailable"}}
    </p>

    <button
      type="button"
      data-action="cancel"
    >
      {{localize "AWAKE.Scars.Cancel"}}
    </button>

  {{/if}}

</div>